# Local development. Copy to .env; keep credentials out of Git.
MYSQL_URL=jdbc:mysql://127.0.0.1:3307/neighbor_life?sslMode=DISABLED&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=neighbor
MYSQL_PASSWORD=REPLACE_ME
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
APP_INSTANCE_ID=neighbor-life-local-1
BUSINESS_TIME_ZONE=Asia/Shanghai
UPLOAD_DIRECTORY=./uploads
ADMIN_USER_IDS=

# Explicit local simulation. General application defaults are disabled.
SMS_MODE=mock
PAYMENT_MODE=mock
DEMO_PAYMENT_ENABLED=false
ORDER_CLOSE_TIMEOUT_MINUTES=15
ORDER_CLOSE_SCAN_DELAY_MS=30000
ORDER_CLOSE_BATCH_SIZE=100
SHOP_LOCAL_CACHE_MAX_SIZE=1000
SHOP_LOCAL_CACHE_TTL_SECONDS=60
CACHE_INVALIDATION_DELAY_MS=500

# For real channels set SMS_MODE=aliyun and PAYMENT_MODE=wechat.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
WECHAT_APP_ID=
WECHAT_MERCHANT_ID=
WECHAT_MERCHANT_SERIAL=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PUBLIC_KEY_PATH=
WECHAT_PUBLIC_KEY_ID=
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_URL=
# Production TLS/Sentinel settings: deploy/application.env.example
