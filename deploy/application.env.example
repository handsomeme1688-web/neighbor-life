SPRING_PROFILES_ACTIVE=prod
APP_INSTANCE_ID=neighbor-life-prod-1
BUSINESS_TIME_ZONE=Asia/Shanghai
MYSQL_URL=jdbc:mysql://mysql.internal:3306/neighbor_life?sslMode=VERIFY_IDENTITY&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=neighbor_life
MYSQL_PASSWORD=REPLACE_ME
MYSQL_TRUSTSTORE_URL=file:/run/keys/mysql-truststore.p12
MYSQL_TRUSTSTORE_PASSWORD=REPLACE_ME
REDIS_SENTINEL_MASTER=neighbor
REDIS_SENTINEL_NODES=sentinel-1.internal:26379,sentinel-2.internal:26379,sentinel-3.internal:26379
REDIS_SENTINEL_PASSWORD=REPLACE_ME
REDIS_PASSWORD=REPLACE_ME
REDIS_TRUSTSTORE_PATH=/run/keys/redis-truststore.p12
REDIS_TRUSTSTORE_PASSWORD=REPLACE_ME
KAFKA_BOOTSTRAP_SERVERS=kafka-1.internal:9093,kafka-2.internal:9093,kafka-3.internal:9093
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="neighbor" password="REPLACE_ME";
KAFKA_TRUSTSTORE_PATH=/run/keys/kafka-truststore.p12
KAFKA_TRUSTSTORE_PASSWORD=REPLACE_ME
ADMIN_USER_IDS=REPLACE_WITH_BOOTSTRAP_ADMIN_ID
WECHAT_APP_ID=REPLACE_ME
WECHAT_MERCHANT_ID=REPLACE_ME
WECHAT_MERCHANT_SERIAL=REPLACE_ME
WECHAT_PRIVATE_KEY_PATH=/run/keys/wechat-merchant.pem
WECHAT_PUBLIC_KEY_PATH=/run/keys/wechat-public.pem
WECHAT_PUBLIC_KEY_ID=REPLACE_ME
WECHAT_API_V3_KEY=REPLACE_ME
WECHAT_NOTIFY_URL=https://api.example.com/payments/wechat/notify
ALIBABA_CLOUD_ACCESS_KEY_ID=REPLACE_ME
ALIBABA_CLOUD_ACCESS_KEY_SECRET=REPLACE_ME
ALIYUN_SMS_SIGN_NAME=REPLACE_ME
ALIYUN_SMS_TEMPLATE_CODE=REPLACE_ME
